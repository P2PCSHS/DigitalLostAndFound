# Copy this file to .env on the server and edit. .env is git-ignored.
# This file configures docker compose; backend/.env.example is the
# separate one used when running the app directly without Docker.

# Port the app is exposed on by docker compose.
APP_PORT=8080

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
