# Which config class run.py loads: development | production
FLASK_ENV=development

# Required in production, ignored in development unless set.
# Absolute paths need four slashes: sqlite:////data/app.db
# The directory must already exist and be writable by the app user.
DATABASE_URL=

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Overrides where the development database is written.
# Defaults to src/backend/data/
DATA_DIR=
